<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Console: concise, colour-free so CI logs stay readable. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{28} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- File: full detail, rolled per run, kept under test-results/logs. -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>test-results/logs/execution.log</file>
    <!--
      SizeAndTimeBasedRollingPolicy, not TimeBasedRollingPolicy: the latter
      rejects <maxFileSize> and the %i index, which silently disables the whole
      appender and leaves no log file behind.
    -->
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>test-results/logs/execution.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>7</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Framework classes: verbose enough to trace a failure. -->
  <logger name="factory" level="DEBUG"/>
  <logger name="pages" level="DEBUG"/>
  <logger name="hooks" level="DEBUG"/>
  <logger name="stepdefinitions" level="DEBUG"/>
  <logger name="utils" level="DEBUG"/>

  <!-- Third-party noise. -->
  <logger name="com.microsoft.playwright" level="WARN"/>
  <logger name="io.cucumber" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>
